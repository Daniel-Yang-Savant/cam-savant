{
  "name": "cam-savant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:sw": "node --test tests/service-worker.test.mjs",
    "test:periop": "node --import tsx --test scripts/periop-auth.test.ts",
    "test:fsm": "node --test tests/fsm-*.test.mjs",
    "test:opd": "TSX_TSCONFIG_PATH=scripts/tsconfig.opd-tests.json node --conditions=react-server --import tsx --test scripts/opd-plan-phases.test.ts scripts/opd-hemophilia.test.ts",
    "test:discovery": "node --import tsx --test scripts/article-discovery.test.ts scripts/site-search.test.ts",
    "test:seo": "tsx --test scripts/seo-contract.test.ts scripts/exercise-guide-related.test.ts scripts/exercise-guide-expansion.test.ts scripts/content-review.test.ts scripts/doctor-clinics.test.ts scripts/pagination.test.ts scripts/related-articles.test.ts",
    "optimize:covers": "tsx scripts/optimize-cover-images.ts",
    "publish-post": "tsx scripts/publish-from-pdf.ts",
    "prompts": "ts-node scripts/today-tasks.ts",
    "draft": "ts-node scripts/convert-drafts.ts",
    "publish": "ts-node scripts/publish.ts",
    "add-topic": "ts-node -e \"const fs=require('fs'); const t=JSON.parse(fs.readFileSync('scripts/topics.json')); t.push({slug:process.argv[3], title:process.argv[1], query:process.argv[2], done:false}); fs.writeFileSync('scripts/topics.json', JSON.stringify(t, null, 2));\"",
    "rotate-token": "ts-node scripts/rotate-token.ts",
    "new": "ts-node scripts/new-article.ts",
    "validate:posts": "tsx scripts/validate-posts.ts",
    "prebuild": "npm run test:security && npm run test:sw && npm run warn:resources && npm run validate:posts && npm run test:seo && npm run test:discovery && npm run test:fsm && npm run test:opd && npm run test:periop && npm run test:resources",
    "test:resources": "node --import tsx --test scripts/rehab-resources.test.ts",
    "warn:resources": "node --import tsx scripts/check-rehab-resource-reviews.ts",
    "test:security": "node --import tsx --test scripts/admin-auth.test.ts scripts/content-security.test.ts",
    "test:smoke": "node scripts/security-smoke.mjs"
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "next": "^16.4.3",
    "next-mdx-remote": "^6.0.0",
    "node-fetch": "^2.7.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "zod": "^4.4.2",
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^20.19.37",
    "@types/node-fetch": "^2.6.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.19",
    "critters": "^0.0.23",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "htmlparser2": "8.0.2"
  },
  "overrides": {
    "form-data": "4.0.6",
    "js-yaml": "3.15.2",
    "postcss": "$postcss",
    "sharp": "0.35.5",
    "postcss-selector-parser": "^7.1.6",
    "esbuild": "^0.28.1"
  }
}
