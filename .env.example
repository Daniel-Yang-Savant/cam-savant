# ── Claude API ────────────────────────────────────────────────────────────
# 從 https://console.anthropic.com/settings/keys 取得
ANTHROPIC_API_KEY=

# ── Unsplash API ──────────────────────────────────────────────────────────
# 從 https://unsplash.com/developers 建立 Application 後取得 Access Key
# 審核中可留空，系統會自動切換到 Pexels 備用
UNSPLASH_ACCESS_KEY=

# ── Pexels API（備用圖片來源）────────────────────────────────────────────
# 從 https://www.pexels.com/api/ 申請，馬上可用，免費
PEXELS_API_KEY=

# ── Perioperative Rehab 存取保護 ──────────────────────────────────────────
# 舊連結兌換碼；不是伺服器的簽章密鑰，新 QR 僅使用短效 grant
PERIOP_ACCESS_TOKEN=

# ── 管理員登入 ────────────────────────────────────────────────────────────
# 請使用獨立隨機密碼；登入後以具有伺服器到期驗證的 cookie 存取
ADMIN_SECRET=

# 可選：術後 QR／cookie 簽章專用密鑰，未填時由 ADMIN_SECRET 衍生
# 不得與對外 PERIOP_ACCESS_TOKEN 相同，也不得放入 QR 或網址
PERIOP_SIGNING_SECRET=

# ── FSM Google 登入與會員授權 ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
# 必填：獨立的高強度隨機字串（建議至少 32 bytes），無預設值
# Vercel 請設為 Sensitive；更換此值會讓既有 FSM 登入全部失效
SESSION_SECRET=
AUTHORIZED_EMAILS=
KV_REST_API_URL=
KV_REST_API_TOKEN=
